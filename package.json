{
  "name": "ocf-front",
  "private": true,
  "version": "0.71.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4000 --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --port 4000 --host",
    "test": "vitest run",
    "typecheck:e2e": "tsc --noEmit --ignoreConfig --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --types node e2e/*.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "precommit": "bash scripts/pre-commit-checks.sh",
    "docs:screenshots": "playwright test --project docs"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.7",
    "guacamole-common-js": "^1.5.0",
    "html2canvas": "^1.4.1",
    "marked": "^18.1.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
